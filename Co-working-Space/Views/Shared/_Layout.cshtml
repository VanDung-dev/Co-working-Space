@inject Co_working_Space.Data.ApplicationDbContext DbContext
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    decimal headerWalletBalance = 0;
    string headerDisplayName = "";

    if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var rawName = !string.IsNullOrEmpty(user.UserName) ? user.UserName : (user.Email ?? "");
            headerDisplayName = rawName.Contains('@') ? rawName.Split('@')[0] : rawName;
            if (string.IsNullOrEmpty(headerDisplayName)) headerDisplayName = user.Id;

            var wallet = await DbContext.Wallets.FindAsync(user.Id);
            headerWalletBalance = wallet?.Balance ?? 0;
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Co-working Space</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg site-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Co-working Space</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Room" ? "active" : "")"
                           asp-controller="Room" asp-action="Index">Phòng họp</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Booking" ? "active" : "")"
                               asp-controller="Booking" asp-action="MyBookings">Đơn của tôi</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-light border text-dark fw-medium d-inline-flex align-items-center gap-1 py-1 px-3" title="Xem số dư ví & tài khoản">
                                Ví: <strong class="text-success ms-1">@headerWalletBalance.ToString("N0") đ</strong>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm text-dark fw-semibold px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    Trang Quản trị
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm text-dark fw-semibold px-3" asp-area="Admin" asp-controller="Booking" asp-action="Pending">
                                    Trang Duyệt đơn
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle py-1 text-dark fw-medium" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @headerDisplayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item @(controller == "Account" ? "active" : "")" asp-controller="Account" asp-action="Profile">
                                        Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 text-start">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top py-3 text-center text-muted small" style="background: #fff;">
        &copy; @DateTime.Now.Year — Co-working Space
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const toastSuccess = '@TempData["SuccessMessage"]';
        const toastError = '@TempData["ErrorMessage"]';
        if (toastSuccess) Swal.fire({ icon: 'success', title: toastSuccess, timer: 3000, showConfirmButton: false });
        if (toastError) Swal.fire({ icon: 'error', title: toastError, timer: 5000, showConfirmButton: false });
    </script>
</body>
</html>
