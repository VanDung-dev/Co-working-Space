@model Co_working_Space.Models.ViewModels.CreateBookingViewModel

@{
    ViewData["Title"] = "Đặt phòng họp";
    var room = ViewBag.Room as Co_working_Space.Models.Room;
}

<div class="row justify-content-center g-4">
    <!-- Cột trái: Thông tin phòng họp được chọn -->
    <div class="col-lg-5 col-md-6">
        <div class="card h-100 shadow-sm">
            @if (room != null && !string.IsNullOrEmpty(room.ImageUrl))
            {
                <img src="@room.ImageUrl" class="card-img-top" alt="@room.Name" style="max-height: 220px; object-fit: cover;" />
            }
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-bold mb-0">@(room?.Name ?? "Thông tin phòng họp")</h5>
                    <span class="badge bg-light text-primary border">@(room?.Id ?? ViewBag.RoomId)</span>
                </div>
                
                @if (room != null)
                {
                    <p class="text-muted small mb-3">Vị trí: <strong>@room.Location</strong></p>
                    <div class="p-3 bg-light rounded mb-3 border">
                        <div class="row g-2 text-center">
                            <div class="col-6 border-end">
                                <span class="d-block text-muted small">Sức chứa</span>
                                <strong class="fs-6 text-dark">@room.Capacity người</strong>
                            </div>
                            <div class="col-6">
                                <span class="d-block text-muted small">Giá thuê</span>
                                <strong class="fs-6 text-success">@room.PricePerHour.ToString("N0") đ /h</strong>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(room.Description))
                    {
                        <div class="mb-0">
                            <label class="form-label small text-muted mb-1">Mô tả phòng:</label>
                            <p class="small text-muted mb-0">@room.Description</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Cột phải: Form nhập thông tin đặt phòng -->
    <div class="col-lg-7 col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Tạo yêu cầu đặt phòng</h5>
                <form asp-action="Create" method="post" id="bookingForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="RoomId" value="@(Model?.RoomId ?? ViewBag.RoomId)" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Tiêu đề cuộc họp</label>
                        <input asp-for="Title" class="form-control" placeholder="VD: Họp báo cáo tiến độ tuần" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label">Thời gian bắt đầu</label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control" id="startTime"
                                   value="@(Model?.StartTime > DateTime.MinValue ? Model.StartTime.ToString("yyyy-MM-ddTHH:mm") : "")" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label">Thời gian kết thúc</label>
                            <input asp-for="EndTime" type="datetime-local" class="form-control" id="endTime"
                                   value="@(Model?.EndTime > DateTime.MinValue ? Model.EndTime.ToString("yyyy-MM-ddTHH:mm") : "")" required />
                        </div>
                    </div>
                    <div id="timeError" class="invalid-feedback d-block mb-2 d-none"></div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Ghi chú & Yêu cầu bổ sung</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Yêu cầu chuẩn bị nước uống, micro không dây, bút viết bảng..." required></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fs-6 fw-semibold py-2.5" id="submitBtn">Xác nhận gửi yêu cầu đặt phòng</button>
                        <a asp-action="Index" asp-controller="Room" class="btn btn-outline-secondary py-2">Quay lại danh sách phòng</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const startEl = document.getElementById('startTime');
        const endEl = document.getElementById('endTime');
        const errEl = document.getElementById('timeError');

        function validate() {
            if (!startEl.value || !endEl.value) return true;
            const start = new Date(startEl.value);
            const end = new Date(endEl.value);
            const now = new Date();
            if (start <= now) { errEl.textContent = 'Thời gian bắt đầu phải ở tương lai.'; errEl.classList.remove('d-none'); return false; }
            if (end <= start) { errEl.textContent = 'Thời gian kết thúc phải sau thời gian bắt đầu.'; errEl.classList.remove('d-none'); return false; }
            errEl.classList.add('d-none');
            return true;
        }

        startEl.addEventListener('change', validate);
        endEl.addEventListener('change', validate);

        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            if (!validate()) { e.preventDefault(); return; }
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = 'Đang gửi...';
        });
    </script>
}
