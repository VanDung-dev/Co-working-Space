@{
    ViewData["Title"] = "Trang chủ";
}

@if (User.IsInRole("Admin"))
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
        <div>
            <strong>Xin chào Admin!</strong> Bạn đang đăng nhập với tài khoản Quản trị hệ thống.
        </div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-dark btn-sm fw-semibold">
            Đến Trang Quản Trị &rarr;
        </a>
    </div>
}
else if (User.IsInRole("Staff"))
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
        <div>
            <strong>Xin chào Nhân viên!</strong> Bạn đang đăng nhập với tài khoản Staff.
        </div>
        <a asp-area="Admin" asp-controller="Booking" asp-action="Pending" class="btn btn-dark btn-sm fw-semibold">
            Đến Trang Duyệt Đơn &rarr;
        </a>
    </div>
}

<section class="py-5 text-center">
    <h1 class="display-5 fw-bold mb-3">Phòng họp ngay khi bạn cần</h1>
    <p class="text-muted mx-auto mb-4" style="max-width: 560px;">
        Đặt phòng họp theo giờ trong vài bước. Chọn phòng, chọn thời gian,
        gửi yêu cầu và chờ duyệt — không cần thao tác phức tạp.
    </p>
    <a asp-controller="Room" asp-action="Index" class="btn btn-primary btn-lg px-4">Xem phòng và đặt</a>
</section>

<section class="row g-4 py-4">
    <div class="col-md-4">
        <h6 class="fw-bold mb-1">Đặt theo giờ</h6>
        <p class="text-muted small mb-0">Chọn thời gian phù hợp, chỉ trả tiền cho đúng khoảng thời gian sử dụng.</p>
    </div>
    <div class="col-md-4">
        <h6 class="fw-bold mb-1">Thiết bị sẵn sàng</h6>
        <p class="text-muted small mb-0">Máy chiếu, màn hình, micro… được gắn sẵn theo phòng và kiểm tra định kỳ.</p>
    </div>
    <div class="col-md-4">
        <h6 class="fw-bold mb-1">Duyệt nhanh</h6>
        <p class="text-muted small mb-0">Yêu cầu được xử lý theo thứ tự, trạng thái luôn hiển thị rõ ràng.</p>
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="text-center py-4">
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary px-4">Tạo tài khoản để đặt phòng</a>
    </section>
}
