@{
    ViewData["Title"] = "404 - Không tìm thấy trang";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-1 fw-bold text-danger mb-3">404</h1>
            <h2 class="fs-3 text-secondary mb-4">Trang không tồn tại</h2>
            <p class="lead text-muted mb-4">
                Đường dẫn bạn vừa truy cập không hợp lệ.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-house-door-fill me-2"></i>Quay về Trang chủ
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại trang trước
                </a>
            </div>
        </div>
    </div>
</div>
