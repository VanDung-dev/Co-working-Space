@{
    ViewData["Title"] = "Tổng quan & Phân tích";
    var topCustomers = ViewBag.TopCustomers as List<Co_working_Space.Areas.Admin.Controllers.TopCustomerDto> ?? new();
    var topWalletUsers = ViewBag.TopWalletUsers as List<Co_working_Space.Areas.Admin.Controllers.TopWalletUserDto> ?? new();
    var topRooms = ViewBag.TopRooms as List<Co_working_Space.Areas.Admin.Controllers.RoomStatDto> ?? new();
    var selectedYear = (int)ViewBag.SelectedYear;
    var availableYears = ViewBag.AvailableYears as List<int> ?? new List<int> { selectedYear };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="mb-1 fw-bold">Tổng quan & Phân tích Hệ thống (Năm @selectedYear)</h4>
        <p class="text-muted small mb-0">Thống kê dữ liệu hoạt động, khách hàng thân thiết và hiệu suất phòng họp theo năm.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="small fw-semibold text-nowrap">Chọn năm:</label>
            <select name="year" class="form-select form-select-sm" style="width: auto; min-width: 85px;" onchange="this.form.submit()">
                @foreach (var y in availableYears)
                {
                    <option value="@y" selected="@(y == selectedYear)">@y</option>
                }
            </select>
        </form>
        <a asp-action="ExportCsv" asp-route-year="@selectedYear" class="btn btn-success btn-sm text-nowrap px-3">
            Xuất báo cáo CSV
        </a>
        <a asp-area="Admin" asp-controller="Booking" asp-action="Pending" class="btn btn-primary btn-sm text-nowrap px-3">
            Duyệt đơn chờ
        </a>
    </div>
</div>

<!-- 1. KPI Stats Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Tổng doanh thu</div>
                <div class="fs-5 fw-bold text-success">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Đơn tháng này</div>
                <div class="fs-5 fw-bold text-primary">@ViewBag.MonthlyBookings <span class="fs-6 text-muted font-normal">/ @ViewBag.TotalBookings</span></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Tổng người dùng</div>
                <div class="fs-5 fw-bold text-dark">@ViewBag.TotalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Tổng số dư ví KH</div>
                <div class="fs-5 fw-bold text-info">@(((decimal)ViewBag.TotalWalletBalance).ToString("N0")) đ</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Phòng hoạt động</div>
                <div class="fs-5 fw-bold text-dark">@ViewBag.ActiveRoomsCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small mb-1">Thiết bị sẵn sàng</div>
                <div class="fs-5 fw-bold text-success">@ViewBag.EqAvailable</div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Charts Section -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">Phân bổ Trạng thái Đơn đặt phòng</div>
            <div class="card-body d-flex align-items-center justify-content-center p-3">
                <canvas id="statusChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">Tình trạng Trang thiết bị</div>
            <div class="card-body d-flex align-items-center justify-content-center p-3">
                <canvas id="equipChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-12 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">Top Phòng theo Số giờ sử dụng</div>
            <div class="card-body d-flex align-items-center justify-content-center p-3">
                <canvas id="roomHoursChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 3. Tables Section -->
<div class="row g-3 mb-4">
    <!-- Top Khách hàng Đặt phòng nhiều nhất -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm p-0 overflow-hidden">
            <div class="card-header bg-white fw-bold py-3">Top Khách hàng Đặt phòng nhiều nhất</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 50px;">Hạng</th>
                            <th>Khách hàng (Email)</th>
                            <th class="text-center">Số đơn đã duyệt</th>
                            <th class="text-end pe-3">Tổng chi tiêu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (topCustomers.Any())
                        {
                            int rank = 1;
                            foreach (var c in topCustomers)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge @(rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary text-white" : rank == 3 ? "bg-danger text-white" : "bg-light text-dark border")">#@rank</span></td>
                                    <td class="fw-medium">@c.Email</td>
                                    <td class="text-center fw-bold">@c.BookingCount</td>
                                    <td class="text-end pe-3 fw-semibold text-success">@c.TotalSpent.ToString("N0") đ</td>
                                </tr>
                                rank++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-muted small text-center py-3">Chưa có dữ liệu khách hàng.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top Khách hàng Nạp / Số dư ví cao nhất -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm p-0 overflow-hidden">
            <div class="card-header bg-white fw-bold py-3">Top Khách hàng Số dư Ví lớn nhất</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 50px;">Hạng</th>
                            <th>Khách hàng (Email)</th>
                            <th class="text-end pe-3">Số dư ví hiện tại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (topWalletUsers.Any())
                        {
                            int rank = 1;
                            foreach (var w in topWalletUsers)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge @(rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary text-white" : rank == 3 ? "bg-danger text-white" : "bg-light text-dark border")">#@rank</span></td>
                                    <td class="fw-medium">@w.Email</td>
                                    <td class="text-end pe-3 fw-bold text-success">@w.Balance.ToString("N0") đ</td>
                                </tr>
                                rank++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-muted small text-center py-3">Chưa có dữ liệu ví tiền.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 4. Top Phòng họp được đặt & Thời gian sử dụng -->
<div class="card shadow-sm p-0 overflow-hidden mb-4">
    <div class="card-header bg-white fw-bold py-3">Thống kê Chi tiết Phòng họp được đặt & Thời gian thuê</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Tên phòng họp</th>
                    <th>Vị trí</th>
                    <th class="text-center">Số lần đã duyệt</th>
                    <th class="text-center">Tổng thời gian sử dụng</th>
                    <th class="text-end pe-3">Tổng doanh thu phòng</th>
                </tr>
            </thead>
            <tbody>
                @if (topRooms.Any())
                {
                    foreach (var r in topRooms)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@r.RoomName</td>
                            <td>@r.Location</td>
                            <td class="text-center"><span class="badge bg-primary px-2.5">@r.BookingCount lần</span></td>
                            <td class="text-center fw-semibold text-dark">@r.TotalHours giờ</td>
                            <td class="text-end pe-3 fw-bold text-success">@r.TotalRevenue.ToString("N0") đ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-muted small text-center py-3">Chưa có phòng họp nào được duyệt đặt.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Status Chart
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Chờ duyệt', 'Đã duyệt', 'Từ chối', 'Đã hủy'],
                datasets: [{
                    data: [@ViewBag.PendingCount, @ViewBag.ApprovedCount, @ViewBag.RejectedCount, @ViewBag.CancelledCount],
                    backgroundColor: ['#f59e0b', '#10b981', '#ef4444', '#6b7280']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Equipment Chart
        const ctxEquip = document.getElementById('equipChart').getContext('2d');
        new Chart(ctxEquip, {
            type: 'pie',
            data: {
                labels: ['Sẵn sàng', 'Bảo trì', 'Hỏng'],
                datasets: [{
                    data: [@ViewBag.EqAvailable, @ViewBag.EqMaintenance, @ViewBag.EqBroken],
                    backgroundColor: ['#10b981', '#f59e0b', '#ef4444']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Room Hours Chart
        const roomNames = [@Html.Raw(string.Join(",", topRooms.Select(r => $"'{r.RoomName}'")))];
        const roomHours = [@string.Join(",", topRooms.Select(r => r.TotalHours))];

        const ctxRoomHours = document.getElementById('roomHoursChart').getContext('2d');
        new Chart(ctxRoomHours, {
            type: 'bar',
            data: {
                labels: roomNames.length > 0 ? roomNames : ['Chưa có dữ liệu'],
                datasets: [{
                    label: 'Số giờ sử dụng',
                    data: roomHours.length > 0 ? roomHours : [0],
                    backgroundColor: '#3b82f6'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
