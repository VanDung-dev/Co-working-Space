@model List<Co_working_Space.Models.Equipment>

@{
    ViewData["Title"] = "Quản lý thiết bị";
    var statusText = new Dictionary<EquipmentStatus, string> {
        { EquipmentStatus.Available, "Sẵn sàng" }, { EquipmentStatus.Maintenance, "Bảo trì" },
        { EquipmentStatus.Broken, "Hỏng" }
    };
    var statusBadge = new Dictionary<EquipmentStatus, string> {
        { EquipmentStatus.Available, "badge-available" }, { EquipmentStatus.Maintenance, "badge-maintenance" },
        { EquipmentStatus.Broken, "badge-broken" }
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Quản lý thiết bị</h4>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <label class="form-label">Tên thiết bị</label>
                <input name="name" class="form-control form-control-sm" placeholder="VD: Máy chiếu" required />
            </div>
            <div class="col-auto">
                <label class="form-label">Mô tả</label>
                <input name="description" class="form-control form-control-sm" placeholder="Không bắt buộc" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Thêm</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có thiết bị nào.</p>
}
else
{
    <div class="card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Trạng thái</th>
                        <th>Phòng</th>
                        <th>Ghi chú</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eq in Model)
                    {
                        var rooms = eq.RoomEquipments?.Select(re => re.Room?.Name).Where(n => !string.IsNullOrEmpty(n));
                        <tr>
                            <td class="fw-medium">@eq.Name</td>
                            <td><span class="badge @statusBadge[eq.Status]">@statusText[eq.Status]</span></td>
                            <td>@(rooms != null && rooms.Any() ? string.Join(", ", rooms) : "—")</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(eq.Note) ? "—" : eq.Note)</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 align-items-end">
                                    <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@eq.Id" />
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="0" selected="@(eq.Status == EquipmentStatus.Available)">Sẵn sàng</option>
                                            <option value="1" selected="@(eq.Status == EquipmentStatus.Maintenance)">Bảo trì</option>
                                            <option value="2" selected="@(eq.Status == EquipmentStatus.Broken)">Hỏng</option>
                                        </select>
                                        <input name="note" class="form-control form-control-sm" placeholder="Ghi chú..."
                                               value="@eq.Note" style="width: 120px;" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Lưu</button>
                                    </form>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Transfer" asp-route-id="@eq.Id" class="btn btn-outline-info">Điều chuyển</a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@eq.Id" method="post"
                                                  onsubmit="return confirmDelete('@eq.Name')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger">Xóa</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(name) {
            return Swal.fire({
                title: 'Xóa thiết bị?',
                text: name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc2626'
            }).then(r => r.isConfirmed);
        }
    </script>
}
